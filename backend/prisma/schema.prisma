datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

model Customer {
  id              Int        @id @default(autoincrement())
  accountNumber   String     @unique // e.g. 0001330
  businessName    String     // e.g. AMERICAN AUTO CARE & TIRES
  contactName     String?    
  email           String?
  phone           String?
  address         String?
  city            String?
  state           String?
  zip             String?
  creditLimit     Float      @default(0.0)
  terms           String     @default("Net 30")
  pin             String     @default("1234")
  
  // Aging buckets from Daily Report
  futureBalance   Float      @default(0.0)
  currentBalance  Float      @default(0.0)
  pastDue0130     Float      @default(0.0)
  pastDue3160     Float      @default(0.0)
  pastDueOver61   Float      @default(0.0)
  totalDue        Float      @default(0.0)

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  invoices        Invoice[]
  payments        PaymentTransaction[]
  rmaClaims       RmaClaim[]

  @@index([accountNumber])
  @@index([businessName])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique // e.g. 0010071699
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date          DateTime
  dueDate       DateTime
  status        String        // CURRENT, OVERDUE_30, OVERDUE_60, OVERDUE_90, PAID
  agingBucket   String?       // Future, Current, 01-30, 31-60, Over 61
  subtotal      Float         @default(0.0)
  tireFee       Float         @default(0.0)
  freight       Float         @default(0.0)
  total         Float         @default(0.0)
  balanceDue    Float         @default(0.0)
  poNumber      String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      PaymentTransaction[]
  rmaClaims     RmaClaim[]

  @@index([customerId])
  @@index([invoiceNumber])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tireBrand      String   // Goodyear, Michelin, etc.
  pattern        String   // Assurance WeatherReady, Defender LTX M/S
  size           String   // 225/65R17 102H
  ply            String?  // Standard Load, Load Range E (10-Ply)
  sku            String   // GY-2256517-AWR
  qty            Int
  wholesalePrice Float
  extendedPrice  Float

  @@index([invoiceId])
}

model PaymentTransaction {
  id                Int       @id @default(autoincrement())
  paymentNumber     String    @unique // PAY-108291
  customerId        Int
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId         Int?
  invoice           Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount            Float
  method            String    // STRIPE_CARD, STRIPE_LINK, ZELLE, CHECK
  status            String    // COMPLETED, PENDING_CLEARANCE, PENDING_VERIFICATION, FAILED
  transactionId     String?   // Stripe pi_... or ch_...
  checkNumber       String?
  checkDate         DateTime?
  zelleConfirmation String?
  notes             String?
  createdAt         DateTime  @default(now())

  @@index([customerId])
  @@index([invoiceId])
  @@index([method])
  @@index([status])
}

model RmaClaim {
  id               Int       @id @default(autoincrement())
  claimNumber      String    @unique // RMA-60291
  customerId       Int
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId        Int?
  invoice          Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  tireBrand        String
  tireSize         String
  dotSerial        String    // DOT 6G9L 3J8R 1424
  treadDepth       String    // 8/32", 10/32", New
  reason           String    // Out-of-round / Ride vibration, Sidewall blister, Bead defect, Casing fault, Shipping error
  photoUrl         String?
  status           String    @default("SUBMITTED") // SUBMITTED, UNDER_INSPECTION, CREDIT_MEMO_ISSUED, REJECTED
  creditAmount     Float?
  creditMemoNumber String?   // CM-50123
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([customerId])
  @@index([claimNumber])
  @@index([status])
}

